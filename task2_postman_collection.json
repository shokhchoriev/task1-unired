{
  "info": {
    "_postman_id": "task2-transfer-rpc-collection",
    "name": "Task 2 – Transfer JSON-RPC API",
    "description": "JSON-RPC 2.0 endpoints for the Transfer microservice.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/task2/",
      "type": "string"
    },
    {
      "key": "ext_id",
      "value": "tr-00000001",
      "type": "string"
    },
    {
      "key": "otp",
      "value": "",
      "type": "string"
    },
    {
      "key": "last_state",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "transfer.create",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Har safar yangi unikal ext_id yaratadi",
              "const timestamp = Date.now();",
              "const ext_id = 'tr-' + timestamp;",
              "pm.collectionVariables.set('ext_id', ext_id);",
              "console.log('ext_id set to:', ext_id);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "if (json.result) {",
              "    pm.test('State is created', () => {",
              "        pm.expect(json.result.state).to.eql('created');",
              "    });",
              "    pm.test('otp_sent is true', () => {",
              "        pm.expect(json.result.otp_sent).to.be.true;",
              "    });",
              "    pm.collectionVariables.set('last_state', json.result.state);",
              "    console.log('Transfer yaratildi. ext_id:', json.result.ext_id);",
              "    console.log('OTP ni Telegramdan olib, transfer.confirm ga kiriting');",
              "} else if (json.error) {",
              "    pm.test('Error: ' + json.error.message, () => { pm.expect(json.error.code).to.exist; });",
              "    console.log('Xato kodi:', json.error.code, '|', json.error.message);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"transfer.create\",\n  \"params\": {\n    \"ext_id\": \"{{ext_id}}\",\n    \"sender_card_number\": \"8600123412341234\",\n    \"sender_card_expiry\": \"12/26\",\n    \"receiver_card_number\": \"8600567812345678\",\n    \"sending_amount\": 15000,\n    \"currency\": 643\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}", "host": ["{{base_url}}"] },
        "description": "Transfer yaratadi. OTP Telegram ga yuboriladi."
      },
      "response": [
        {
          "name": "Success",
          "status": "OK", "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"result\": {\n    \"ext_id\": \"tr-1234567890\",\n    \"state\": \"created\",\n    \"otp_sent\": true\n  }\n}"
        },
        {
          "name": "Error – ext_id exists",
          "status": "OK", "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"error\": { \"code\": 32701, \"message\": \"Ext id already exists\" }\n}"
        },
        {
          "name": "Error – balance not enough",
          "status": "OK", "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"error\": { \"code\": 32702, \"message\": \"Balance is not enough\" }\n}"
        },
        {
          "name": "Error – card not active",
          "status": "OK", "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"error\": { \"code\": 32705, \"message\": \"Card is not active\" }\n}"
        }
      ]
    },
    {
      "name": "transfer.confirm",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// ext_id collectiondan avtomatik olinadi",
              "const ext_id = pm.collectionVariables.get('ext_id');",
              "console.log('Confirming ext_id:', ext_id);",
              "console.log('OTP ni Body da to ldirib yuboring');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "if (json.result) {",
              "    pm.test('State is confirmed', () => {",
              "        pm.expect(json.result.state).to.eql('confirmed');",
              "    });",
              "    pm.collectionVariables.set('last_state', json.result.state);",
              "    console.log('Transfer tasdiqlandi! State:', json.result.state);",
              "} else if (json.error) {",
              "    const code = json.error.code;",
              "    if (code === 32712) {",
              "        pm.test('OTP noto lri – urinishlar qoldi', () => pm.expect(code).to.eql(32712));",
              "        console.log('Xato OTP:', json.error.message);",
              "    } else if (code === 32711) {",
              "        pm.test('Urinishlar tugadi – transfer bekor qilindi', () => pm.expect(code).to.eql(32711));",
              "        console.log('Transfer bekor qilindi:', json.error.message);",
              "    } else {",
              "        console.log('Xato:', json.error.code, json.error.message);",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"method\": \"transfer.confirm\",\n  \"params\": {\n    \"ext_id\": \"{{ext_id}}\",\n    \"otp\": \"123456\"\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}", "host": ["{{base_url}}"] },
        "description": "OTP bilan transferni tasdiqlaydi."
      },
      "response": [
        {
          "name": "Success",
          "status": "OK", "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"result\": {\n    \"ext_id\": \"tr-1234567890\",\n    \"state\": \"confirmed\"\n  }\n}"
        },
        {
          "name": "Error – OTP wrong",
          "status": "OK", "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"error\": { \"code\": 32712, \"message\": \"OTP is wrong, left try count is 2\" }\n}"
        },
        {
          "name": "Error – try count reached",
          "status": "OK", "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"error\": { \"code\": 32711, \"message\": \"Count of try is reached\" }\n}"
        },
        {
          "name": "Error – OTP expired",
          "status": "OK", "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"error\": { \"code\": 32710, \"message\": \"OTP expired\" }\n}"
        }
      ]
    },
    {
      "name": "transfer.cancel",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const ext_id = pm.collectionVariables.get('ext_id');",
              "console.log('Cancelling ext_id:', ext_id);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "if (json.result) {",
              "    pm.test('State is cancelled', () => {",
              "        pm.expect(json.result.state).to.eql('cancelled');",
              "    });",
              "    pm.collectionVariables.set('last_state', 'cancelled');",
              "    console.log('Transfer bekor qilindi.');",
              "} else if (json.error) {",
              "    pm.test('Cancel failed: ' + json.error.message, () => pm.expect(json.error.code).to.exist);",
              "    console.log('Xato:', json.error.code, json.error.message);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 3,\n  \"method\": \"transfer.cancel\",\n  \"params\": {\n    \"ext_id\": \"{{ext_id}}\"\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}", "host": ["{{base_url}}"] },
        "description": "Transferni bekor qiladi (faqat 'created' holatda)."
      },
      "response": [
        {
          "name": "Success",
          "status": "OK", "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 3,\n  \"result\": { \"state\": \"cancelled\" }\n}"
        },
        {
          "name": "Error – wrong state",
          "status": "OK", "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 3,\n  \"error\": { \"code\": 32706, \"message\": \"Transfer cannot be cancelled in current state\" }\n}"
        }
      ]
    },
    {
      "name": "transfer.state",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const ext_id = pm.collectionVariables.get('ext_id');",
              "console.log('Checking state for ext_id:', ext_id);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "if (json.result) {",
              "    pm.test('State exists', () => pm.expect(json.result.state).to.be.oneOf(['created', 'confirmed', 'cancelled']));",
              "    pm.collectionVariables.set('last_state', json.result.state);",
              "    console.log('Joriy holat:', json.result.state);",
              "} else if (json.error) {",
              "    console.log('Topilmadi:', json.error.message);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 4,\n  \"method\": \"transfer.state\",\n  \"params\": {\n    \"ext_id\": \"{{ext_id}}\"\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}", "host": ["{{base_url}}"] },
        "description": "Transfer holatini qaytaradi."
      },
      "response": [
        {
          "name": "Success",
          "status": "OK", "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 4,\n  \"result\": { \"ext_id\": \"tr-1234567890\", \"state\": \"confirmed\" }\n}"
        }
      ]
    },
    {
      "name": "transfer.history",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('Tarix so ravoti yuborilmoqda...');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "if (json.result) {",
              "    pm.test('Result is array', () => pm.expect(json.result).to.be.an('array'));",
              "    console.log('Jami tarix yozuvlari:', json.result.length);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 5,\n  \"method\": \"transfer.history\",\n  \"params\": {\n    \"card_number\": \"8600123412341234\",\n    \"start_date\": \"2025-01-01\",\n    \"end_date\": \"2026-12-31\",\n    \"status\": \"confirmed\"\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}", "host": ["{{base_url}}"] },
        "description": "Transfer tarixini filtrlaydi."
      },
      "response": [
        {
          "name": "Success – with results",
          "status": "OK", "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 5,\n  \"result\": [\n    { \"ext_id\": \"tr-001\", \"sending_amount\": \"150000.00\", \"state\": \"confirmed\", \"created_at\": \"2026-04-10T08:30:00\" }\n  ]\n}"
        }
      ]
    },
    {
      "name": "card.info (cache 30s)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('card.info so rovi — birinchi marta DB dan, keyingisi Redis cache dan (30s).');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "if (json.result) {",
              "    pm.test('card_status exists', () => pm.expect(json.result.card_status).to.be.oneOf(['active', 'inactive', 'expired']));",
              "    pm.test('balance exists', () => pm.expect(json.result.balance).to.be.a('string'));",
              "    pm.test('masked_card format', () => {",
              "        const masked = json.result.masked_card;",
              "        pm.expect(masked).to.match(/^\\d{6}\\*+\\d{4}$/);",
              "    });",
              "    console.log('Karta holati:', json.result.card_status);",
              "    console.log('Balans:', json.result.balance, 'UZS');",
              "    console.log('Masked:', json.result.masked_card);",
              "    console.log('Telefon:', json.result.phone);",
              "} else if (json.error) {",
              "    console.log('Xato:', json.error.code, json.error.message);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 6,\n  \"method\": \"card.info\",\n  \"params\": {\n    \"card_number\": \"8600123412341234\",\n    \"expiry\": \"12/26\"\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}", "host": ["{{base_url}}"] },
        "description": "Karta ma'lumotlarini qaytaradi. Natija 30 soniyaga Redis da saqlanadi (Task 3.4 Cache)."
      },
      "response": [
        {
          "name": "Success (DB dan)",
          "status": "OK", "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 6,\n  \"result\": {\n    \"card_status\": \"active\",\n    \"balance\": \"500000.00\",\n    \"phone\": \"+998901234567\",\n    \"masked_card\": \"860012******1234\"\n  }\n}"
        },
        {
          "name": "Error – card not found",
          "status": "OK", "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 6,\n  \"error\": { \"code\": 32704, \"message\": \"Card expiry is not valid\" }\n}"
        }
      ]
    }
  ]
}
